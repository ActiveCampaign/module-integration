<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_onepage_controller_success_action">
        <observer instance="ActiveCampaign\Order\Observer\OrderSync" name="ac_order_sync_sales_order_save_after"/>
    </event>
    <event name="sales_order_save_before">
        <observer instance="ActiveCampaign\Order\Observer\OrderStatusFlag" name="ac_order_status_flag"/>
    </event>
    <event name="sales_order_save_after">
        <observer instance="ActiveCampaign\Order\Observer\OrderStatusSync" name="ac_order_status_sync"/>
    </event>
    <event name="sales_order_cancel_after">
        <observer instance="ActiveCampaign\Order\Observer\OrderStatusFlag" name="ac_order_status_flag_external"/>
        <observer instance="ActiveCampaign\Order\Observer\OrderStatusSync" name="ac_order_status_sync_external"/>
    </event>
</config>
